   "source": [
    "import torch\n",
    "import torch_directml\n",
    "\n",
    "device = torch_directml.device()\n",
    "\n",
    "x = torch.tensor([2.0], device=device, requires_grad=True)\n",
    "loss = (x * x).sum()\n",
    "loss.backward()\n",
    "\n",
    "print(\"Device:\", device)\n",
    "print(\"Result:\", loss.cpu().item())\n",
    "print(\"Gradient:\", x.grad.cpu().item())"
   ]
  },
